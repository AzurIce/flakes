+
+#[test]
+fn rotated_outputs_keep_their_fractional_scale() {
+    use wayland_client::protocol::wl_output::Transform;
+
+    for transform in [
+        Transform::_90,
+        Transform::_270,
+        Transform::Flipped90,
+        Transform::Flipped270,
+    ] {
+        let mut output = make_output_info(
+            "HDMI-A-2",
+            "Rotated 1440p display",
+            Size {
+                width: 2560,
+                height: 1440,
+            },
+            LogicalRegion {
+                inner: Region {
+                    position: Position { x: -1152, y: -200 },
+                    size: Size {
+                        width: 1152,
+                        height: 2048,
+                    },
+                },
+            },
+        );
+        output.transform = transform;
+        assert_eq!(output.scale(), 1.25, "{transform:?}");
+        mem::forget(output);
+    }
+}
