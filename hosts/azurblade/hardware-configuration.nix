# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

let
  uuid = "f0b77243-be47-40b8-a19b-6c07a606200f";
  persistFs = path: {
    device = "/persist${path}";
    neededForBoot = true;
    fsType = "none";
    options = [ "bind" ];
  };
  btrSubvolFs = subvol: {
    device = "/dev/disk/by-uuid/${uuid}";
    fsType = "btrfs";
    options = [ "subvol=${subvol}" ];
  };
  persistBind = baseDir: path: {
    name = "${if baseDir == "/" then "" else baseDir}${path}";
    value = persistFs path;
  };
in
{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ahci"
    "nvme"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];
  boot.supportedFilesystems = [ "ntfs" ];
  boot.kernelPackages = pkgs.linuxKernel.packages.linux_7_3;

  fileSystems = {
    "/boot" = {
      device = "/dev/disk/by-uuid/7854-92D2";
      fsType = "vfat";
      options = [
        "fmask=0022"
        "dmask=0022"
      ];
    };

    "/" = btrSubvolFs "@root";
    "/nix" = btrSubvolFs "@nix";
    "/home" = btrSubvolFs "@home";
    "/persist" = (btrSubvolFs "@persist") // {
      neededForBoot = true;
    };
    # "/gaming" = {
    #   device = "/dev/nvme0n1p5";
    #   fsType = "ntfs";
    #   options = [ "rw" "uid=1000" "gid=100" "user" "exec" "umask=000" ];
    # };
  }
  // builtins.listToAttrs [
    (persistBind "/" "/var/log")
    (persistBind "/etc" "/ssh/ssh_host_ed25519_key")
    (persistBind "/etc" "/ssh/ssh_host_ed25519_key.pub")
    (persistBind "/etc" "/ssh/ssh_host_rsa_key")
    (persistBind "/etc" "/ssh/ssh_host_rsa_key.pub")
  ];

  swapDevices = [ { device = "/dev/disk/by-uuid/556e864c-bb77-4863-8655-06fcb27e8886"; } ];

  # systemd stage 1 不再支持 boot.initrd.postDeviceCommands，
  # 把原来清空 @root 的脚本搬成 initrd 服务（与 aorus-nixos 同一做法）。
  boot.initrd.systemd = {
    extraBin = {
      btrfs = "${pkgs.btrfs-progs}/bin/btrfs";
      find = "${pkgs.findutils}/bin/find";
    };
    services.btrfs-root-reset = {
      description = "Archive old BTRFS root subvolume and create a fresh one";
      wantedBy = [ "initrd.target" ];
      before = [ "sysroot.mount" ];
      after = [ "initrd-root-device.target" ];
      requires = [ "initrd-root-device.target" ];
      unitConfig.DefaultDependencies = "no";
      serviceConfig.Type = "oneshot";
      script = ''
        set -euo pipefail
        export LC_ALL=C
        mountpoint=/btrfs_tmp
        mkdir -p "$mountpoint"
        mount -o subvolid=5 /dev/disk/by-uuid/${uuid} "$mountpoint"
        trap 'umount "$mountpoint"' EXIT

        mkdir -p "$mountpoint/old_roots"
        if [[ -e "$mountpoint/@root" ]]; then
          timestamp=$(date -u +%Y-%m-%d_%H-%M-%S)
          mv -- "$mountpoint/@root" "$mountpoint/old_roots/$timestamp"
        fi

        delete_subvolume_recursively() {
          local subvol
          while IFS= read -r subvol; do
            delete_subvolume_recursively "$mountpoint/$subvol"
          done < <(btrfs subvolume list -o "$1" | cut -f 9- -d ' ')
          btrfs subvolume delete "$1"
        }

        while IFS= read -r -d "" old_root; do
          delete_subvolume_recursively "$old_root"
        done < <(find "$mountpoint/old_roots" -mindepth 1 -maxdepth 1 -mtime +30 -print0)

        btrfs subvolume create "$mountpoint/@root"
      '';
    };
  };

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.eno2.useDHCP = lib.mkDefault true;
  # networking.interfaces.wlo1.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
