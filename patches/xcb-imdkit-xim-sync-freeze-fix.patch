+         * subsequent key from this client is queued but never dispatched
+         * (the client's keyboard freezes / all keys are swallowed).
+         * See https://github.com/fcitx/fcitx5/issues/1641 */
         if (!ic) {
-            break;
+            fprintf(stderr,
+                    "[xcb-imdkit] XIM_SYNC_REPLY for already-destroyed IC "
+                    "(id=%u): keyboard-freeze path hit, clearing sync flag\n",
+                    frame.input_context_ID);
         }
-
         client->sync = false;
         if (im->sync) {
             im->sync = false;
 
-            if (im->callback) {
+            if (ic && im->callback) {
                 im->callback(im, client, ic, hdr, &frame, NULL, im->user_data);
             }
         }
