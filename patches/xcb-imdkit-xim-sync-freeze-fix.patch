diff --git a/src/protocolhandler.c b/src/protocolhandler.c
index 69783f9..15bbf48 100644
--- a/src/protocolhandler.c
+++ b/src/protocolhandler.c
@@ -11,6 +11,7 @@
 #include "parser.h"
 #include "uthash.h"
 #include <stdbool.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/types.h>
@@ -842,15 +843,23 @@ void _xcb_im_handle_sync_reply(xcb_im_t *im, xcb_im_client_t *client,
         xcb_im_input_context_t *ic = NULL;
         HASH_FIND(hh, client->input_contexts, &frame.input_context_ID,
                   sizeof(uint16_t), ic);
+        /* The IC may have been destroyed (XIM_DESTROY_IC racing with an
