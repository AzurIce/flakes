+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alvr_common::ConnectionError;
+    use std::{io::Write, net::Shutdown, sync::mpsc, thread};
+
+    fn pair() -> (TcpStream, MultiplexedTcpReader) {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let peer = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (socket, _) = listener.accept().unwrap();
+        socket
+            .set_read_timeout(Some(Duration::from_millis(100)))
+            .unwrap();
+        (
+            peer,
+            MultiplexedTcpReader {
+                inner: socket.into(),
+                prefix: [0; PACKET_PREFIX_SIZE],
+                prefix_cursor: 0,
+                in_progress_packet: None,
+                used_buffers_poll_timeout: Duration::from_millis(100),
+            },
+        )
+    }
+
+    fn packet(payload: &[u8]) -> Vec<u8> {
+        let mut bytes = Vec::new();
+        bytes.extend_from_slice(&1u16.to_le_bytes());
+        bytes.extend_from_slice(&0u32.to_le_bytes());
+        bytes.extend_from_slice(&(payload.len() as u32).to_le_bytes());
+        bytes.extend_from_slice(payload);
+        bytes
+    }
+
+    fn assert_eof(bytes: &[u8]) {
+        let (mut peer, mut reader) = pair();
+        peer.write_all(bytes).unwrap();
+        peer.shutdown(Shutdown::Write).unwrap();
+        let (tx, rx) = mpsc::channel();
+        thread::spawn(move || {
+            for _ in 0..8 {
+                match reader.recv(&HashMap::new()) {
+                    Err(ConnectionError::TryAgain(_)) => continue,
+                    result => {
+                        tx.send(result).unwrap();
+                        return;
+                    }
+                }
+            }
+        });
+        assert!(matches!(
+            rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+            Err(ConnectionError::Other(_))
+        ));
+    }
+
+    #[test]
+    fn eof_before_prefix() {
+        assert_eof(&[]);
+    }
+
+    #[test]
+    fn eof_during_prefix() {
+        assert_eof(&packet(b"hello")[..3]);
+    }
+
+    #[test]
+    fn eof_during_payload() {
+        assert_eof(&packet(b"hello")[..PACKET_PREFIX_SIZE + 2]);
+    }
+
+    #[test]
+    fn fragmented_packet_survives_retries() {
+        let (mut peer, mut reader) = pair();
+        let bytes = packet(b"hello");
+        let (used_tx, used_rx) = mpsc::channel();
+        used_tx.send(Vec::new()).unwrap();
+        let (packet_tx, packet_rx) = mpsc::channel();
+        let queues = HashMap::from([(
+            1,
+            StreamRecvQueues {
+                used_buffer_sender: used_tx,
+                used_buffer_receiver: used_rx,
+                packet_queue: packet_tx,
+            },
+        )]);
+        peer.write_all(&bytes[..3]).unwrap();
+        assert!(matches!(
+            reader.recv(&queues),
+            Err(ConnectionError::TryAgain(_))
+        ));
+        peer.write_all(&bytes[3..PACKET_PREFIX_SIZE + 2]).unwrap();
+        assert!(matches!(
+            reader.recv(&queues),
+            Err(ConnectionError::TryAgain(_))
+        ));
+        // An idle peer must return control, keeping the partially received payload.
+        assert!(matches!(
+            reader.recv(&queues),
+            Err(ConnectionError::TryAgain(_))
+        ));
+        peer.write_all(&bytes[PACKET_PREFIX_SIZE + 2..]).unwrap();
+        assert!(reader.recv(&queues).is_ok());
+        assert_eq!(packet_rx.recv().unwrap().buffer, bytes);
+    }
+
+    #[test]
+    fn shutdown_interrupts_receive() {
+        let (_peer, mut reader) = pair();
+        reader.inner.set_read_timeout(None).unwrap();
+        let shutdown = reader.shutdown_handle().unwrap().unwrap();
+        let (tx, rx) = mpsc::channel();
+        thread::spawn(move || {
+            tx.send(reader.recv(&HashMap::new())).unwrap();
+        });
+        shutdown.shutdown(Shutdown::Both).unwrap();
+        assert!(matches!(
+            rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+            Err(ConnectionError::Other(_))
+        ));
+    }
+
+    #[test]
+    fn shutdown_interrupts_send() {
+        let (_peer, reader) = pair();
+        reader.inner.set_send_buffer_size(4096).unwrap();
+        let shutdown = reader.shutdown_handle().unwrap().unwrap();
+        let mut writer = MultiplexedTcpWriter {
+            inner: reader.inner.try_clone().unwrap().into(),
+        };
+        let (started_tx, started_rx) = mpsc::channel();
+        let (tx, rx) = mpsc::channel();
+        thread::spawn(move || {
+            let mut buffer = vec![0; 8 * 1024 * 1024];
+            started_tx.send(()).unwrap();
+            tx.send(writer.send(1, 0, &mut buffer)).unwrap();
+        });
+        started_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+        assert!(matches!(
+            rx.recv_timeout(Duration::from_millis(100)),
+            Err(mpsc::RecvTimeoutError::Timeout)
+        ));
+        shutdown.shutdown(Shutdown::Both).unwrap();
+        assert!(rx.recv_timeout(Duration::from_secs(2)).unwrap().is_err());
+    }
+}
