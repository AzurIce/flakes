+// Independent of the send locks, so teardown can interrupt blocked I/O before joining threads.
+pub struct ConnectionShutdown {
+    control: TcpStream,
+    stream: Option<TcpStream>,
+}
+
+impl ConnectionShutdown {
+    pub fn new<T>(control: &ControlSocketSender<T>, stream: &StreamSocket) -> ConResult<Self> {
+        Ok(Self {
+            control: control.inner.try_clone().to_con()?,
+            stream: stream.shutdown_handle().to_con()?,
+        })
+    }
+
+    pub fn shutdown(&self) {
+        self.control.shutdown(Shutdown::Both).ok();
+        if let Some(stream) = &self.stream {
+            stream.shutdown(Shutdown::Both).ok();
+        }
+    }
+}
+
 impl SocketConnection {
+    pub fn shutdown_handle(&self) -> ConResult<ConnectionShutdown> {
+        Ok(ConnectionShutdown {
+            control: self.control_socket.inner.try_clone().to_con()?,
+            stream: self.stream_socket.shutdown_handle().to_con()?,
+        })
+    }
+
